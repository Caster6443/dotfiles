// 此配置文件使用 KDL 格式: https://kdl.dev
// "/-" 用于注释掉紧随其后的节点。
// 请查看 Wiki 获取配置的完整说明:
// https://yalter.github.io/niri/Configuration:-Introduction
environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    //LANG "zh_CN.UTF-8"
    LC_MESSAGES "zh_CN.UTF-8"
    // 修复 GTK4 应用 (Nautilus, 设置等) 在混合显卡机器上被 Vulkan 后端唤醒独显导致的卡顿。
    // 2026-09-14 修正：原先写 "gl"；GTK 4.18 起旧 GL 渲染器已移除，本机 GTK 4.22.4 对 "gl"
    // 会打 "will cause a warning and use the new OpenGL renderer" 的警告，规范名是 "opengl"
    // （与 ~/.config/environment.d/gsk-renderer.conf 保持一致）。
    GSK_RENDERER "opengl"
    //确保 XWayland 应用能使用 Fcitx5 输入中文
    XMODIFIERS "@im=fcitx"
    //GTK_IM_MODULE "fcitx"
    QT_IM_MODULE "fcitx"
    //让 Qt 应用 (VLC, OBS等) 使用 qt6ct/qt5ct 进行主题管理
    QT_QPA_PLATFORMTHEME "qt6ct"
}

// ── 显卡：niri 只在 A 卡（AMD 780M 核显）上跑 ──────────────────────────────
// debug 段是 niri 的「调试/实验」选项区（官方明说不保证配置接口稳定）。
// 目的：让 niri 完全不打开 N 卡（RTX 4060, 0000:01:00.0）的任何 DRM 节点，
// 这样 libvirt 直通前的占用检查 (fuser /dev/nvidia* /dev/dri/renderD*) 才不会
// 因为 niri 而拒绝启动 VM。用 by-path 而非 card0/renderD129，因为编号每次启动会变。
// 改完需要重开 niri（该选项在启动时生效，热重载不一定应用）。
debug {
    ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-card"
    ignore-drm-device "/dev/dri/by-path/pci-0000:01:00.0-render"
    render-drm-device "/dev/dri/by-path/pci-0000:66:00.0-render"
}

// 你可以更改屏幕截图的保存路径。
// 开头的 ~ 将被展开为用户主目录 (/home/你的用户名)。
// 路径格式遵循 strftime(3) 标准，以自动填入截图的日期和时间。
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
// 你也可以将其设置为 null 以禁用将截图保存到磁盘（只复制到剪贴板）。
// screenshot-path null

// ══════════════════════════════════════════════════════════════════════
// 模块化配置（2026-09-14 重构）
//
// 布局与 Hyprland 侧同构：
//   ~/.config/hypr/hyprland.lua        主文件（顶层设置 + require 列表）
//   ~/.config/hypr/hyprland/*.lua      模块
//   ~/.config/hypr/scripts/*           脚本
//        ↕ 一一对应
//   ~/.config/niri/config.kdl          主文件（environment/debug/screenshot-path + include 列表）
//   ~/.config/niri/config.d/*.kdl      模块
//   ~/.config/niri/scripts/*           脚本
//
// 注意：niri 的 include 只接受具体路径，**不支持通配符**（26.04 用 `niri validate` 实测
// `include "./config.d/*.kdl"` 会报 "No such file or directory"），所以新增模块要在这里补一行。
// 校验命令：niri validate -c ~/.config/niri/config.kdl
// ══════════════════════════════════════════════════════════════════════

// 输入设备（键盘/触摸板/鼠标）
include "./config.d/input.kdl"
// 显示器
include "./config.d/outputs.kdl"
// 布局、间隙、聚焦环、阴影、圆角
include "./config.d/layout.kdl"
// 动画
include "./config.d/animations.kdl"
// 窗口规则 / 图层规则
include "./config.d/window_rules.kdl"
// 快捷键
include "./config.d/binds.kdl"
// 开机自启进程
include "./config.d/autostart.kdl"
