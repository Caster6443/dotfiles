// 你可以通过名称配置输出（显示器），在 niri 实例中运行
// `niri msg outputs` 可以找到这些名称。
// 内置笔记本显示器通常称为 "eDP-1"。
// 在 Wiki 上查找更多信息：
// https://yalter.github.io/niri/Configuration:-Outputs
// 记得通过移除 "/-" 来取消对该节点的注释！
/-output "eDP-1" {
    // 取消注释此行以禁用此输出。
    // off

    // 分辨率以及可选的输出刷新率。
    // 格式为 "<宽>x<高>" 或 "<宽>x<高>@<刷新率>"。
    // 如果省略刷新率，niri 将选择该分辨率下的
    // 最高刷新率。
    // 如果完全省略模式配置或配置无效，niri 将自动选择一个模式。
    // 在 niri 实例中运行 `niri msg outputs` 可列出所有输出及其模式。
    mode "1920x1080@120.030"

    // 你可以使用整数或小数缩放，例如使用 1.5 代表 150% 缩放。
    scale 2

    // Transform 允许逆时针旋转输出，有效值为：
    // normal, 90, 180, 270, flipped, flipped-90, flipped-180 和 flipped-270。
    transform "normal"

    // 输出在全局坐标空间中的位置。
    // 这会影响定向显示器操作（如 "focus-monitor-left"）以及光标移动。
    // 光标只能在直接相邻（紧挨着）的输出之间移动。
    // 定位时必须考虑输出的缩放和旋转：输出的大小是按“逻辑”像素或缩放后的像素计算的。
    // 例如，一个 3840×2160 的输出如果缩放比例 (scale) 为 2.0，其逻辑大小将是 1920×1080，
    // 因此，要将另一个输出直接放在它右侧，需将其 x 坐标设置为 1920。
    // 如果位置未设置或导致重叠，输出将被自动放置。
    position x=1280 y=0
}

output "eDP-1" {
		mode "2560x1440@165"
		scale 1.3 	 //缩放
		position x=1920 y=0 //
		focus-at-startup //打开niri时自动聚焦该窗口
}

output "HDMI-A-1" {
		mode "1920x1080@60"
		scale 1
		position x=0 y=0 
}
