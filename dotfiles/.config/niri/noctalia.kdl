layout {

    focus-ring {
        active-color   "#b9c3fe"
        inactive-color "#131317"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b9c3fe"
        inactive-color "#131317"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#b9c3fe"
        inactive-color "#5f6a9f"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b9c3fe80"
    }
}

recent-windows {
    highlight {
        active-color "#b9c3fe"
        urgent-color "#ffb4ab"
    }
}
