layout {

    focus-ring {
        active-color   "#ffc27b"
        inactive-color "#17120e"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffc27b"
        inactive-color "#17120e"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffc27b"
        inactive-color "#e3a65d"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffc27b80"
    }
}

recent-windows {
    highlight {
        active-color "#ffc27b"
        urgent-color "#ffb4ab"
    }
}
