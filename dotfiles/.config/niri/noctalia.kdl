layout {

    focus-ring {
        active-color   "#ffb4a5"
        inactive-color "#200f0b"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb4a5"
        inactive-color "#200f0b"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb4a5"
        inactive-color "#ff5538"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb4a580"
    }
}

recent-windows {
    highlight {
        active-color "#ffb4a5"
        urgent-color "#ffb4ab"
    }
}
