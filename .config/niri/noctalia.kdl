layout {

    focus-ring {
        active-color   "#b5c9d8"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#b5c9d8"
        inactive-color "#131314"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#b5c9d8"
        inactive-color "#7f93a1"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#b5c9d880"
    }
}

recent-windows {
    highlight {
        active-color "#b5c9d8"
        urgent-color "#ffb4ab"
    }
}
